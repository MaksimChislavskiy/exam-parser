# Выбор LLM-провайдера по умолчанию: mistral или gigachat
LLM_PROVIDER=mistral

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-2512

# GigaChat
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL_CERTS=true
# При необходимости укажите путь к корневому сертификату НУЦ Минцифры:
# GIGACHAT_CA_BUNDLE_FILE=C:/path/to/russian_trusted_root_ca.pem
GIGACHAT_TIMEOUT=180
GIGACHAT_MAX_TOKENS=8192
GIGACHAT_MAX_RETRIES=6
GIGACHAT_RETRY_BACKOFF_FACTOR=1
