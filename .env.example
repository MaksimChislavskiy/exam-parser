# Выбор LLM-провайдера по умолчанию: mistral, gigachat или deepseek
LLM_PROVIDER=mistral

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-2512

# GigaChat
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL_CERTS=true
# При необходимости укажите путь к корневому сертификату НУЦ Минцифры:
# GIGACHAT_CA_BUNDLE_FILE=C:/path/to/russian_trusted_root_ca.pem
GIGACHAT_TIMEOUT=180
GIGACHAT_MAX_TOKENS=8192
GIGACHAT_MAX_RETRIES=6
GIGACHAT_RETRY_BACKOFF_FACTOR=1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=180
DEEPSEEK_MAX_RETRIES=6
DEEPSEEK_MAX_TOKENS=16384
DEEPSEEK_REASONING_EFFORT=high
# Максимальная длина одного окончательного решения.
DEEPSEEK_MAX_SOLUTION_CHARS=8000
# Ограничения для повторов после слишком длинного или оборванного решения.
DEEPSEEK_COMPACT_MAX_TOKENS=2400
DEEPSEEK_MINIMAL_MAX_TOKENS=1200
# Дополнительный независимый запрос проверки решения и ответа.
DEEPSEEK_VERIFY_SOLUTIONS=true
